# Use a dedicated demo database and Neon Auth branch. Never use production credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Keep mock mode for deterministic local review. OpenRouter is used only after
# the user explicitly activates PartnerBird Agent evaluation.
PARTNERBIRD_AGENT_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_MODEL_FREE=
OPENROUTER_MODEL_PRO=
OPENROUTER_MODEL_BUSINESS=
OPENROUTER_FREE_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PartnerBird WebMCP Demo
OPENROUTER_TIMEOUT_MS=20000

PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
PUBLIC_PROFILE_HANDLE=darren

RESEND_API_KEY=
PARTNERBIRD_EMAIL_FROM=PartnerBird Demo <hello@example.com>
RATE_LIMIT_HMAC_SECRET=

PARTNERBIRD_MESSAGE_LIMIT=30
PARTNERBIRD_URL_ANALYSIS_LIMIT=3
PARTNERBIRD_MAX_MESSAGE_LENGTH=4000
PARTNERBIRD_MAX_FETCH_BYTES=1048576
PARTNERBIRD_MAX_EXTRACTED_CHARS=50000
